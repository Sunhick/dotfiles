# ~/.config/git/config — single source of truth
# Git reads this XDG file natively, alongside ~/.gitconfig.

# ---------------------------------------------------------------------------
# Identity includes (conditional on directory)
# ---------------------------------------------------------------------------

[includeIf "gitdir:~/prv/**"]
    path = ~/.gitconfig-personal
[includeIf "gitdir:~/personal/**"]
    path = ~/.gitconfig-personal
[includeIf "gitdir:~/projects/personal/**"]
    path = ~/.gitconfig-personal

[includeIf "gitdir:~/work/**"]
    path = ~/.gitconfig-work
[includeIf "gitdir:~/projects/work/**"]
    path = ~/.gitconfig-work
[includeIf "gitdir:~/company/**"]
    path = ~/.gitconfig-work

# This repo is personal wherever it is checked out, even under ~/work (e.g. as
# a submodule of a work repo). Listed after the work rules so it wins.
# hasconfig needs git >= 2.36; older git ignores it.
[includeIf "hasconfig:remote.*.url:https://github.com/Sunhick/**"]
    path = ~/.gitconfig-personal
[includeIf "hasconfig:remote.*.url:git@github.com:Sunhick/**"]
    path = ~/.gitconfig-personal

# OS-specific. Git has no OS condition, so key off where repos live: macOS
# homes are under /Users, Linux homes under /home (or /local/home on cloud
# desktops). Repos elsewhere get neither file and use `gpg` from PATH.
[includeIf "gitdir:/Users/"]
    path = ~/.config/git/macOS.gitconfig
[includeIf "gitdir:/home/"]
    path = ~/.config/git/linux.gitconfig
[includeIf "gitdir:/local/home/"]
    path = ~/.config/git/linux.gitconfig

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------

[core]
    precomposeUnicode = true
    # No core.editor: git falls back to $VISUAL/$EDITOR (emacsclient, set in
    # bash/exports), so commit messages open in the running Emacs daemon.
    untrackedCache = true
    pager = less -FMRiX
    # Prevent commits with mixed line endings
    autocrlf = input

[init]
    defaultBranch = main

# ---------------------------------------------------------------------------
# Commit signing
# Whether to sign (commit.gpgSign / tag.gpgSign / user.signingkey) is decided
# per profile in ~/.gitconfig-personal and ~/.gitconfig-work, not here.
# ---------------------------------------------------------------------------

[commit]
    verbose = true

# ---------------------------------------------------------------------------
# Merge / Diff
# ---------------------------------------------------------------------------

[merge]
    tool = ediff
    conflictStyle = zdiff3

[mergetool "ediff"]
    cmd = emacs --eval \"(ediff-merge-files-with-ancestor \\\"$LOCAL\\\" \\\"$REMOTE\\\" \\\"$BASE\\\" nil \\\"$MERGED\\\")\"
    trustExitCode = true

[mergetool "vscode"]
    cmd = code --wait --merge $REMOTE $LOCAL $BASE $MERGED

[diff]
    tool = ediff
    colorMoved = zebra
    wsErrorHighlight = all
    algorithm = histogram
    renames = copies

[difftool "ediff"]
    cmd = emacs --eval \"(ediff-files \\\"$LOCAL\\\" \\\"$REMOTE\\\")\"

[difftool "vscode"]
    cmd = code --wait --diff $LOCAL $REMOTE

# ---------------------------------------------------------------------------
# Behavior
# ---------------------------------------------------------------------------

[color]
    ui = auto

# List output (branch, tag, status untracked) in columns when on a terminal
[column]
    ui = auto

# Most recently committed branches first; tags in version order (v1.10 > v1.9)
[branch]
    sort = -committerdate
[tag]
    sort = version:refname

[grep]
    lineNumber = true

[pull]
    ff = only

[push]
    default = current
    autoSetupRemote = true

[fetch]
    prune = true
    pruneTags = true

[rebase]
    autoStash = true
    # Apply fixup!/squash! commits automatically in `rebase -i`
    autoSquash = true
    # Move branches stacked on the rebased one along with it (git >= 2.38)
    updateRefs = true

[rerere]
    enabled = true

[help]
    autocorrect = prompt

[log]
    date = iso

# ---------------------------------------------------------------------------
# Aliases
# ---------------------------------------------------------------------------

[alias]
    st = status -sb
    co = checkout
    br = branch
    ci = commit
    ca = commit -a
    cm = commit -m
    cam = commit -am
    unstage = reset HEAD --
    last = log -1 HEAD
    visual = !gitk

    # Logging / graph
    l1 = log --pretty=format:'%C(yellow)%h %Cred%d %<|(90)%Creset%s%Cblue %<(15)%cn %C(dim white)%ar' --decorate --date=short
    lg = log --graph --pretty=format:'%C(auto)%h %C(bold blue)%an%C(reset) %C(dim white)%cr %C(green)%s %C(red)%d' --abbrev-commit --date=relative
    commit-message = log --format=%B -n 1
    dag = log --graph --format='format:%C(yellow)%h%C(reset) %C(blue)\"%an\" <%ae>%C(reset) %C(magenta)%cr%C(reset)%C(auto)%d%C(reset)%n%s' --date-order

    # Delete local branches merged into HEAD. Never touches the current
    # branch, origin's default branch, or main/master/mainline/develop.
    # Whole-name matches only, so feature/main-menu is not protected.
    cleanup = "!f() { \
        cur=$(git branch --show-current); \
        def=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null); \
        def=${def#origin/}; \
        git for-each-ref --merged HEAD --format='%(refname:short)' refs/heads/ | \
        while IFS= read -r b; do \
            case \"$b\" in \"$cur\"|\"$def\"|main|master|mainline|develop) continue ;; esac; \
            git branch -d \"$b\"; \
        done; \
    }; f"

    # Show files ignored by git
    ignored = ls-files -o -i --exclude-standard

    # Show current user identity
    whoami = "!echo \"$(git config user.name) <$(git config user.email)>\""

    # Quick context switch
    personal = "!f() { \
        git config --local include.path ~/.gitconfig-personal && \
        git config --local user.name \"$(git config --file ~/.gitconfig-personal user.name)\" && \
        git config --local user.email \"$(git config --file ~/.gitconfig-personal user.email)\" && \
        echo 'Switched to personal configuration'; \
    }; f"
    work = "!f() { \
        git config --local include.path ~/.gitconfig-work && \
        git config --local user.name \"$(git config --file ~/.gitconfig-work user.name)\" && \
        git config --local user.email \"$(git config --file ~/.gitconfig-work user.email)\" && \
        echo 'Switched to work configuration'; \
    }; f"

# ---------------------------------------------------------------------------
# Local overrides (untracked, per-machine). Last, so they override the above.
# ---------------------------------------------------------------------------

[include]
    path = ~/.config/git/local
