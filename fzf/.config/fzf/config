#!/usr/bin/env bash
# FZF minimal configuration

# Gruvbox color scheme
export FZF_DEFAULT_OPTS="
--color=bg+:#3c3836,bg:#1d2021,spinner:#fb4934,hl:#928374
--color=fg:#ebdbb2,header:#928374,info:#8ec07c,pointer:#fb4934
--color=marker:#fb4934,fg+:#ebdbb2,prompt:#fb4934,hl+:#fb4934
--height=40%
--layout=reverse
--border"

# Only trigger fzf completion on ** (not on every Tab)
export FZF_COMPLETION_TRIGGER='**'

# fzf runs these commands itself, so aliases don't apply: use the real binary
# name (Debian/Ubuntu ship fd and bat as fdfind and batcat).
_fzf_fd=$(command -v fd || command -v fdfind)
_fzf_bat=$(command -v bat || command -v batcat)

# Use fd if available, otherwise find
if [[ -n "$_fzf_fd" ]]; then
    export FZF_DEFAULT_COMMAND="${_fzf_fd##*/} --type f --hidden --follow --exclude .git"
    export FZF_ALT_C_COMMAND="${_fzf_fd##*/} --type d --hidden --follow --exclude .git"
fi

# Enhanced file preview with bat if available
if [[ -n "$_fzf_bat" ]]; then
    export FZF_CTRL_T_OPTS="--preview '${_fzf_bat##*/} --color=always --style=numbers --line-range=:100 {}'"
elif command -v cat >/dev/null 2>&1; then
    export FZF_CTRL_T_OPTS="--preview 'head -100 {}'"
fi

# Directory preview with tree or ls
if command -v tree >/dev/null 2>&1; then
    export FZF_ALT_C_OPTS="--preview 'tree -C {} | head -100'"
elif command -v ls >/dev/null 2>&1; then
    export FZF_ALT_C_OPTS="--preview 'ls -la {} | head -100'"
fi
unset _fzf_fd _fzf_bat

# History search with preview
export FZF_CTRL_R_OPTS="--preview 'echo {}' --preview-window down:3:hidden:wrap --bind '?:toggle-preview'"
