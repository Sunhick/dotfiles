#!/usr/bin/env bash

# Editor preferences
export EDITOR="emacs"
export VISUAL="$EDITOR"
export FCEDIT="$EDITOR"

# Locale — set LANG only; avoid LC_ALL, which overrides every LC_* category
# and clobbers per-category locale settings inherited from the environment.
export LANG="${LANG:-en_US.UTF-8}"

# GPG configuration — must be set fresh each shell (not cached). Only on a
# terminal: without one, tty prints "not a tty" into the variable.
if [[ -t 0 ]]; then
    export GPG_TTY=$(tty)
fi

# Less configuration
export LESS="-R -F -X"
export LESSHISTFILE="-"

# Development tools
# Note: GREP_OPTIONS is deprecated and removed in newer grep versions.
# Color is handled via aliases in ~/.config/bash/aliases instead.
# GREP_COLORS for GNU grep; GREP_COLOR for macOS BSD grep (GNU grep >= 3.8
# only warns about GREP_COLOR when GREP_COLORS doesn't set mt).
export GREP_COLORS="mt=1;32"
export GREP_COLOR="1;32"

# Ripgrep configuration (XDG compliant)
export RIPGREP_CONFIG_PATH="${XDG_CONFIG_HOME:-$HOME/.config}/ripgrep/config"

# Path additions, prepended if they exist. Listed lowest priority first, so
# ~/.local/bin ends up first on PATH.
for dir in "/usr/local/bin" "$HOME/bin" "$HOME/.local/bin"; do
    if [[ -d "$dir" && ":$PATH:" != *":$dir:"* ]]; then
        export PATH="$dir:$PATH"
    fi
done
unset dir
