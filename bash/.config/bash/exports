#!/usr/bin/env bash

# Editor preferences
export EDITOR="emacs"
export VISUAL="$EDITOR"
export FCEDIT="$EDITOR"

# Locale — set LANG only; avoid LC_ALL, which overrides every LC_* category
# and clobbers per-category locale settings inherited from the environment.
export LANG="${LANG:-en_US.UTF-8}"
# Only fall back to LC_CTYPE if nothing locale-related is already configured,
# so UTF-8 still works when LANG is unset in a bare environment.
if [[ -z "${LANG:-}" && -z "${LC_ALL:-}" && -z "${LC_CTYPE:-}" ]]; then
    export LC_CTYPE="en_US.UTF-8"
fi

# GPG configuration — must be set fresh each shell (not cached)
export GPG_TTY=$(tty 2>/dev/null || echo "")

# Less configuration
export LESS="-R -F -X"
export LESSHISTFILE="-"

# Development tools
# Note: GREP_OPTIONS is deprecated and removed in newer grep versions.
# Color is handled via aliases in ~/.config/bash/aliases instead.
export GREP_COLOR="1;32"

# Ripgrep configuration (XDG compliant)
export RIPGREP_CONFIG_PATH="${XDG_CONFIG_HOME:-$HOME/.config}/ripgrep/config"

# Path additions (will be prepended if directories exist)
for dir in "$HOME/.local/bin" "$HOME/bin" "/usr/local/bin"; do
    if [[ -d "$dir" && ":$PATH:" != *":$dir:"* ]]; then
        export PATH="$dir:$PATH"
    fi
done
