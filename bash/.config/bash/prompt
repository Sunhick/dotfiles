#!/usr/bin/env bash
# Colors (bold_blue, reset_color, ...) are defined in the colors file,
# which bashrc sources before this one.
# shellcheck disable=SC2154

# Prompt glyph, coloured by the last command's exit status. Single-width
# (Greek letters like β are East Asian "ambiguous" width and can throw off
# cursor placement in some terminals/fonts).
prompt_glyph='❯'
unset start_glyph end_glyph 2>/dev/null

# No git branch in the prompt (deliberate). Drop any helper left over from
# an older version of this file when it's re-sourced in a running shell.
unset -f git_branch 2>/dev/null

# Run a function from PROMPT_COMMAND without dropping hooks other tools
# (iTerm2, zoxide, mise, direnv) put there. Prepended, so it sees the last
# command's exit status first. Safe to call again on `reload`.
_prompt_command_add() {
    local fn=$1 entry
    if (( BASH_VERSINFO[0] > 5 || (BASH_VERSINFO[0] == 5 && BASH_VERSINFO[1] >= 1) )); then
        # bash 5.1+: PROMPT_COMMAND may be an array, one command per element
        for entry in "${PROMPT_COMMAND[@]}"; do
            [[ "$entry" == "$fn" ]] && return 0
        done
        PROMPT_COMMAND=("$fn" "${PROMPT_COMMAND[@]}")
    else
        # Older bash (Amazon Linux 2 ships 4.2): a single ;-separated string
        # shellcheck disable=SC2128,SC2178
        [[ ";${PROMPT_COMMAND//[[:space:]]/};" == *";$fn;"* ]] && return 0
        # shellcheck disable=SC2128,SC2178
        PROMPT_COMMAND="$fn${PROMPT_COMMAND:+;$PROMPT_COMMAND}"
    fi
}

# Prompt command function
prompt_command() {
    local last_exit_code=$?

    # Share history across terminals: append this shell's new lines to the
    # history file, then read lines other shells have appended since.
    history -a
    history -n

    local prompt=""

    # Show AWS profile if set
    if [[ -n "$AWS_PROFILE" ]]; then
        prompt+="${bold_orange}[${AWS_PROFILE}]${reset_color} "
    fi

    # Current working directory
    prompt+="${bold_cyan}\W${reset_color} "

    # Prompt glyph: green after success, red after a failed command
    if [[ "$last_exit_code" -ne 0 ]]; then
        prompt+="${bold_red}${prompt_glyph}${reset_color} "
    else
        prompt+="${bold_green}${prompt_glyph}${reset_color} "
    fi

    # Set terminal title: user:dirname
    prompt="\[\e]0;\u:\W\a\]${prompt}"

    PS1="$prompt"
    PS2="${bold_yellow}>${reset_color} "
    return "$last_exit_code"
}

# Set up prompt based on terminal capability
if [[ -n "$INSIDE_EMACS" ]]; then
    # Inside Emacs shell-mode — plain prompt, no ANSI escapes
    # Comint with TERM=dumb doesn't render colors reliably
    _emacs_prompt_command() {
        local last_exit=$?
        local indicator
        if [[ "$last_exit" -ne 0 ]]; then
            indicator="x"
        else
            indicator="φ"
        fi
        PS1="${indicator} \W ❯ "
        return "$last_exit"
    }
    _prompt_command_add _emacs_prompt_command
elif [[ "$TERM" == "dumb" || "$TERM" == "unknown" ]]; then
    PS1="> "
else
    _prompt_command_add prompt_command
fi
