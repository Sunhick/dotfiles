#!/usr/bin/env bash

# XDG Base Directory Specification
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"

# Bash configuration directory
BASH_CONFIG_DIR="${XDG_CONFIG_HOME}/bash"

# Safe source function
include() {
    if [[ -f "$1" ]]; then
        source "$1"
    elif [[ "${2:-}" != "optional" ]]; then
        echo "Warning: Could not source $1" >&2
    fi
}

# Detect Docker environment
if [[ -f "/.dockerenv" ]]; then
    # Inside Docker – use container-specific rc
    include "${XDG_CONFIG_HOME}/bash/dockerrc" "optional"
    return
fi

# Non-interactive shells (`ssh host cmd` and scp, which sshd runs through
# ~/.bashrc, or `bash -lc` from IDEs): set up the environment and PATH only;
# skip the prompt, key bindings, completion and ble.sh.
if [[ $- != *i* ]]; then
    include "${BASH_CONFIG_DIR}/exports"
    case "$OSTYPE" in
        darwin*) include "${BASH_CONFIG_DIR}/darwin" ;;
        linux*)  include "${BASH_CONFIG_DIR}/linux" ;;
    esac
    include "${XDG_CONFIG_HOME}/work/bash/local" "optional"
    return
fi

# Load shell options first
include "${BASH_CONFIG_DIR}/shopt"

# ble.sh line editor (highlighting, autosuggestions), if installed. Loaded
# detached before any `bind` so it picks up readline/inputrc and the fzf
# bindings below; attached at the end of this file. Settings: blesh package.
if [[ $- == *i* && -z "$INSIDE_EMACS" && "$TERM" != "dumb" &&
      -f "${XDG_DATA_HOME}/blesh/ble.sh" ]]; then
    source "${XDG_DATA_HOME}/blesh/ble.sh" --attach=none
fi

# Load readline configuration (XDG compliant)
# Skip inside Emacs where line editing is unavailable
if [[ -z "$INSIDE_EMACS" && "$TERM" != "dumb" ]]; then
    if [[ -f "${XDG_CONFIG_HOME}/readline/inputrc" ]]; then
        bind -f "${XDG_CONFIG_HOME}/readline/inputrc"
    fi
fi

# Load environment variables
include "${BASH_CONFIG_DIR}/exports"

# Load history configuration
include "${BASH_CONFIG_DIR}/history" "optional"

# Load colors and prompt
include "${BASH_CONFIG_DIR}/colors"
include "${BASH_CONFIG_DIR}/prompt"

# Load aliases
include "${BASH_CONFIG_DIR}/aliases"

# Load OS-specific configuration
case "$OSTYPE" in
    darwin*)
        include "${BASH_CONFIG_DIR}/darwin"
        ;;
    linux*)
        include "${BASH_CONFIG_DIR}/linux"
        ;;
esac

# Tool aliases need the OS file's PATH and must override its ls aliases
_modern_tool_aliases
unset -f _modern_tool_aliases

# Source a tool's generated shell init, cached under ~/.cache/bash and
# regenerated only when the tool's binary is newer than the cache (same
# approach as brew shellenv in darwin). Usage: _cached_init NAME CMD [ARGS...]
_cached_init() {
    local name=$1 bin cache
    shift
    bin=$(command -v "$1") || return 0
    cache="${XDG_CACHE_HOME:-$HOME/.cache}/bash/${name}_init.bash"
    if [[ ! -s "$cache" || "$bin" -nt "$cache" ]]; then
        [[ -d "${cache%/*}" ]] || mkdir -p "${cache%/*}"
        "$@" > "$cache" 2>/dev/null || { rm -f "$cache"; return 0; }
    fi
    source "$cache"
}

# zoxide: `z foo` jumps to the most used directory matching foo, `zi` picks
# interactively with fzf. Plain `cd` is unchanged.
_cached_init zoxide zoxide init bash

# mise: per-project tool versions (node, python, go, ...) from .mise.toml or
# .tool-versions. Before the work overrides, so their PATH choices win.
_cached_init mise mise activate bash
unset -f _cached_init

# Load git completion only (skip bash-completion — _longopt breaks macOS)
if [[ -z "$INSIDE_EMACS" && "$TERM" != "dumb" ]]; then
    for _git_comp in \
        "/opt/homebrew/opt/git/etc/bash_completion.d/git-completion.bash" \
        "/opt/homebrew/etc/bash_completion.d/git-completion.bash" \
        "/usr/share/bash-completion/completions/git"; do
        if [[ -r "$_git_comp" ]]; then
            source "$_git_comp"
            break
        fi
    done
    unset _git_comp
fi

# Load fzf keybindings only (Ctrl-R, Ctrl-T, Alt-C)
if [[ -z "$INSIDE_EMACS" ]]; then
    include "${XDG_CONFIG_HOME}/fzf/fzf.bash" "optional"
fi

# Load dir_colors for ls coloring (cached to avoid subprocess on every shell)
_dircolors_cache="${XDG_CACHE_HOME:-$HOME/.cache}/bash/dir_colors.sh"
if [[ ! -f "$_dircolors_cache" || "${BASH_CONFIG_DIR}/dir_colors" -nt "$_dircolors_cache" ]]; then
    [[ -d "${_dircolors_cache%/*}" ]] || mkdir -p "${_dircolors_cache%/*}"
    if command -v gdircolors >/dev/null 2>&1; then
        if [[ -f "${BASH_CONFIG_DIR}/dir_colors" ]]; then
            gdircolors -b "${BASH_CONFIG_DIR}/dir_colors" > "$_dircolors_cache"
        else
            gdircolors -b > "$_dircolors_cache"
        fi
    elif command -v dircolors >/dev/null 2>&1; then
        if [[ -f "${BASH_CONFIG_DIR}/dir_colors" ]]; then
            dircolors -b "${BASH_CONFIG_DIR}/dir_colors" > "$_dircolors_cache"
        else
            dircolors -b > "$_dircolors_cache"
        fi
    fi
fi
[[ -f "$_dircolors_cache" ]] && source "$_dircolors_cache"
unset _dircolors_cache

# Load local machine-specific overrides
include "${XDG_CONFIG_HOME}/work/bash/local" "optional"

# Attach ble.sh last, after every config above has run
[[ ! ${BLE_VERSION-} ]] || ble-attach
