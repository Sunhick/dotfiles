#!/usr/bin/env bash

# Navigation shortcuts
alias ..="cd .."
alias ...="cd ../.."
alias ....="cd ../../.."
alias .....="cd ../../../.."
alias ~="cd ~"
alias -- -="cd -"

# List directory contents (generic fallback; darwin overrides for macOS)
alias ls="ls --color=auto"
alias l="ls -lah"
alias la="ls -lAh"
alias ll="ls -lh"
alias lsa="ls -lah"

# Colorize output
alias grep='grep --color=auto'
alias fgrep='grep -F --color=auto'
alias egrep='grep -E --color=auto'
alias tree='tree -C'

# Git shortcuts
alias g="git"
alias gs="git status"
alias ga="git add"
alias gc="git commit"
alias gp="git push"
alias gl="git pull"
alias gd="git diff"
alias gb="git branch"
alias gco="git checkout"

# Safety aliases
alias rm="rm -i"
alias cp="cp -i"
alias mv="mv -i"

# Utility shortcuts
alias h="history"
alias j="jobs"
alias c="clear"
alias reload='source "${XDG_CONFIG_HOME:-$HOME/.config}/bash/bashrc"'

# Modern tool aliases (bat, fd, rg, eza). Defined as a function that bashrc
# calls after the OS file: that file sets the ls aliases eza must override
# and, on macOS, puts Homebrew (where these tools live) on PATH.
_modern_tool_aliases() {
    # Debian/Ubuntu install bat and fd as batcat and fdfind.
    if command -v bat >/dev/null 2>&1; then
        alias cat="bat"
    elif command -v batcat >/dev/null 2>&1; then
        alias bat="batcat"
        alias cat="batcat"
    fi
    if ! command -v fd >/dev/null 2>&1 && command -v fdfind >/dev/null 2>&1; then
        alias fd="fdfind"
    fi
    command -v rg >/dev/null 2>&1 && alias search="rg"

    local ls_cmd
    for ls_cmd in eza exa; do
        if command -v "$ls_cmd" >/dev/null 2>&1; then
            alias ls="$ls_cmd --color=auto"
            alias l="$ls_cmd -lah"
            alias la="$ls_cmd -lAh"
            alias ll="$ls_cmd -lh"
            alias lsa="$ls_cmd -lah"
            break
        fi
    done
}

# Emacs shortcuts
alias es="emacs --daemon"                      # start server
alias ec="emacsclient -c"                      # new frame (client)
alias e="emacsclient -n"                       # open file in existing frame
alias et="emacsclient -t"                      # open in terminal
alias ek='emacsclient -e "(kill-emacs)"'       # kill server
alias er='ek && es'                            # restart server
