# Ghostty config, ported from the iTerm2 "Default" profile
# (terminal/.config/terminal/com.googlecode.iterm2.plist).
# Docs: https://ghostty.org/docs/config/reference
# List all options with: ghostty +show-config --default --docs

# --- Font -------------------------------------------------------------------
# iTerm: "Zenbones-Brainy-Bold 15" (Bold face used as the normal weight)
font-family = "Zenbones Brainy"
font-style = Bold
font-size = 15
# iTerm: ASCII ligatures off
font-feature = -calt
font-feature = -liga
font-feature = -dlig

# --- Colors -----------------------------------------------------------------
# Built-in theme (preview others: ghostty +list-themes). tmux's theme in
# tmux-modern.conf / tmux-legacy.conf is still Gruvbox Material Dark.
theme = Everforest Dark Med
# iTerm: "Brighten bold text"
bold-color = bright
# Nudge colour pairs that would be unreadable (e.g. a tool printing dark grey
# on the dark background). 1 = off, 21 = always black/white.
minimum-contrast = 1.1

# --- Cursor -----------------------------------------------------------------
# iTerm: box cursor, not blinking. The shell prompt (bash/zsh prompt files)
# also resets it to a steady block before each prompt, so it recovers after
# vim etc. leave a bar behind, over ssh too.
cursor-style = block
cursor-style-blink = false

# --- Shell integration ------------------------------------------------------
# no-cursor: keep the block cursor (the `cursor` feature forces a bar at the
# prompt, and only in local shells: it isn't installed on ssh hosts)
# ssh-env/ssh-terminfo: install xterm-ghostty terminfo on remote hosts (dev
# desktops), falling back to TERM=xterm-256color when that's not possible.
# sudo: keep TERMINFO under sudo so xterm-ghostty still resolves
shell-integration-features = no-cursor,ssh-env,ssh-terminfo,sudo

# Desktop notification + bell when a command running 10s+ finishes while the
# window is unfocused. Needs shell integration: local shells only, not ssh.
notify-on-command-finish = unfocused
notify-on-command-finish-after = 10s
notify-on-command-finish-action = bell,notify

# --- Window -----------------------------------------------------------------
window-width = 80
window-height = 25
working-directory = home
confirm-close-surface = false
# Reopen windows (size, position, working directory) after a restart
window-save-state = always

# Space between the text and the window edge; balance centres the grid
window-padding-x = 6
window-padding-y = 4
window-padding-balance = true

# Hide the tab bar; switch tabs from the keyboard (see Tabs keybinds below).
# Linux (GTK) only: macOS ignores this and keeps its native tab bar.
window-show-tab-bar = never

# macOS: slim titlebar in the terminal background colour, kept as a drag
# area. Tabs live in tmux, so a window has one tab and macOS shows no tab bar
# (it appears only with 2+ tabs). `hidden` removes the titlebar too, but then
# windows can only be moved with Ctrl+Cmd+drag (NSWindowShouldDragOnGesture).
# Applies to new windows only (restart Ghostty).
macos-titlebar-style = transparent

# --- Terminal ---------------------------------------------------------------
# iTerm: clipboard access allowed for terminal apps (OSC 52)
clipboard-read = allow
clipboard-write = allow
# Copy selected text straight to the system clipboard
copy-on-select = clipboard

# --- Mouse ------------------------------------------------------------------
mouse-hide-while-typing = true

# --- Keyboard ---------------------------------------------------------------
# iTerm: left Option = Esc+, right Option = normal (for typing special chars)
macos-option-as-alt = left

# iTerm key map (readline-style navigation)
keybind = cmd+left=text:\x01
keybind = cmd+right=text:\x05
keybind = alt+left=esc:b
keybind = alt+right=esc:f
keybind = cmd+backspace=text:\x15
keybind = alt+backspace=text:\x1b\x7f
keybind = alt+delete=esc:d
# iTerm also mapped fn+Delete to ^D; left at Ghostty's default (\e[3~) so it
# can't exit the shell on an empty prompt.

# --- Tabs -------------------------------------------------------------------
# Vim-style prev/next on top of the defaults (Cmd+Shift+[ / ], Ctrl+Tab,
# Cmd+1..9). Cmd is Super on Linux.
keybind = cmd+shift+h=previous_tab
keybind = cmd+shift+l=next_tab

# --- Quick terminal ---------------------------------------------------------
# Drop-down terminal. Not `global:` (that needs macOS Accessibility
# permission), so it toggles only while Ghostty is the focused app.
keybind = ctrl+grave_accent=toggle_quick_terminal

# Already bound by default, not repeated here:
#   Cmd+Shift+P         command palette
#   Cmd+Up / Cmd+Down   jump to previous/next prompt (shell integration)
#   Cmd+Alt+Shift+J     write the screen to a file and open it
