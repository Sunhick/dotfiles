# Ghostty config, ported from the iTerm2 "Default" profile
# (terminal/.config/terminal/com.googlecode.iterm2.plist).
# Docs: https://ghostty.org/docs/config/reference
# List all options with: ghostty +show-config --default --docs

# --- Font -------------------------------------------------------------------
# iTerm: "Zenbones-Brainy-Bold 15" (Bold face used as the normal weight)
font-family = "Zenbones Brainy"
font-style = Bold
font-size = 15
# iTerm: ASCII ligatures off
font-feature = -calt
font-feature = -liga
font-feature = -dlig

# --- Colors -----------------------------------------------------------------
# Built-in theme (preview others: ghostty +list-themes). tmux's theme in
# tmux-modern.conf / tmux-legacy.conf uses the same palette; keep them in step.
theme = Gruvbox Material Dark
# iTerm: "Brighten bold text"
bold-color = bright

# --- Cursor -----------------------------------------------------------------
# iTerm: box cursor, not blinking. Shell integration would otherwise switch
# the cursor to a bar at the prompt.
cursor-style = block
cursor-style-blink = false

# --- Shell integration ------------------------------------------------------
# no-cursor: keep the block cursor (integration would use a bar at the prompt)
# ssh-env/ssh-terminfo: install xterm-ghostty terminfo on remote hosts (dev
# desktops), falling back to TERM=xterm-256color when that's not possible.
shell-integration-features = no-cursor,ssh-env,ssh-terminfo

# --- Window -----------------------------------------------------------------
window-width = 80
window-height = 25
working-directory = home
confirm-close-surface = false

# Hide the tab bar; switch tabs from the keyboard (see Tabs keybinds below).
# Linux (GTK) only: macOS ignores this and keeps its native tab bar.
window-show-tab-bar = never

# macOS: slim titlebar in the terminal background colour, kept as a drag
# area. Tabs live in tmux, so a window has one tab and macOS shows no tab bar
# (it appears only with 2+ tabs). `hidden` removes the titlebar too, but then
# windows can only be moved with Ctrl+Cmd+drag (NSWindowShouldDragOnGesture).
# Applies to new windows only (restart Ghostty).
macos-titlebar-style = transparent

# --- Terminal ---------------------------------------------------------------
# iTerm: clipboard access allowed for terminal apps (OSC 52)
clipboard-read = allow
clipboard-write = allow

# --- Keyboard ---------------------------------------------------------------
# iTerm: left Option = Esc+, right Option = normal (for typing special chars)
macos-option-as-alt = left

# iTerm key map (readline-style navigation)
keybind = cmd+left=text:\x01
keybind = cmd+right=text:\x05
keybind = alt+left=esc:b
keybind = alt+right=esc:f
keybind = cmd+backspace=text:\x15
keybind = alt+backspace=text:\x1b\x7f
keybind = alt+delete=esc:d
# iTerm also mapped fn+Delete to ^D; left at Ghostty's default (\e[3~) so it
# can't exit the shell on an empty prompt.

# --- Tabs -------------------------------------------------------------------
# Vim-style prev/next on top of the defaults (Cmd+Shift+[ / ], Ctrl+Tab,
# Cmd+1..9). Cmd is Super on Linux.
keybind = cmd+shift+h=previous_tab
keybind = cmd+shift+l=next_tab
